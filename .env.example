APP_NAME="A Birthday Surprise"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=single
LOG_LEVEL=debug

# No database — everything is static.
DB_CONNECTION=sqlite
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
DEBUGBAR_ENABLED=false

# Optional overrides for config/birthday.php
# BIRTHDAY_TO=Arina
# BIRTHDAY_FROM=Aravindan
# BIRTHDAY_AGE=26
# BIRTHDAY_TOGETHER_SINCE=2023-02-14

VITE_APP_NAME="${APP_NAME}"
